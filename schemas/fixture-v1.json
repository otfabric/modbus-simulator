{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otfabric.dev/schemas/modbus-simulator/fixture-v1.json",
  "title": "modbus-simulator fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "devices"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "modbus-simulator.fixture.v1" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "metadata": { "type": "object" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/device" }
    }
  },
  "$defs": {
    "unknownAddress": { "enum": ["exception", "zeroForReads"] },
    "stateMode": { "enum": ["persistent", "resetOnConnection"] },
    "area": {
      "enum": ["coils", "discreteInputs", "holdingRegisters", "inputRegisters"]
    },
    "supportedFc": { "enum": [1, 2, 3, 4, 5, 6, 15, 16, 43] },
    "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unknownAddress": { "$ref": "#/$defs/unknownAddress" },
        "stateMode": { "$ref": "#/$defs/stateMode" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "state"],
      "properties": {
        "unitId": { "type": "integer", "minimum": 1, "maximum": 247 },
        "name": { "type": "string" },
        "metadata": { "type": "object" },
        "identity": { "$ref": "#/$defs/identity" },
        "state": { "$ref": "#/$defs/state" },
        "behavior": { "$ref": "#/$defs/behavior" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorName", "productCode", "majorMinorRevision"],
      "properties": {
        "vendorName": { "type": "string" },
        "productCode": { "type": "string" },
        "majorMinorRevision": { "type": "string" },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/identityObject" }
        }
      }
    },
    "identityObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 255 },
        "value": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coils": { "type": "array", "items": { "$ref": "#/$defs/booleanPointWritable" } },
        "discreteInputs": { "type": "array", "items": { "$ref": "#/$defs/booleanPointReadonly" } },
        "holdingRegisters": { "type": "array", "items": { "$ref": "#/$defs/registerPointWritable" } },
        "inputRegisters": { "type": "array", "items": { "$ref": "#/$defs/registerPointReadonly" } }
      }
    },
    "booleanPointWritable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "value"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "value": { "type": "boolean" },
        "writable": { "type": "boolean" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "booleanPointReadonly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "value"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "value": { "type": "boolean" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "registerPointWritable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "value"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "value": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "writable": { "type": "boolean" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "registerPointReadonly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "value"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "value": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unknownAddress": { "$ref": "#/$defs/unknownAddress" },
        "stateMode": { "$ref": "#/$defs/stateMode" },
        "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exceptionRule" } },
        "faults": { "type": "array", "items": { "$ref": "#/$defs/faultRule" } }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "not": { "required": ["address", "addressRange"] },
      "properties": {
        "fc": { "$ref": "#/$defs/supportedFc" },
        "area": { "$ref": "#/$defs/area" },
        "address": { "$ref": "#/$defs/address" },
        "addressRange": { "$ref": "#/$defs/addressRange" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "addressRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/address" },
        "end": { "$ref": "#/$defs/address" }
      }
    },
    "exceptionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "exceptionCode"],
      "properties": {
        "id": { "type": "string" },
        "match": { "$ref": "#/$defs/match" },
        "exceptionCode": {
          "enum": ["illegal_function", "illegal_data_address", "illegal_data_value", "slave_device_failure"]
        }
      }
    },
    "faultRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "fault"],
      "properties": {
        "id": { "type": "string" },
        "match": { "$ref": "#/$defs/match" },
        "fault": { "enum": ["delay", "timeout", "connectionClose"] },
        "delayMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
